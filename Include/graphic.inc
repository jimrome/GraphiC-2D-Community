      MODULE GRAPHIC
!
!     F77 COMPILERS: REPLACE "USE MODULE" STATEMENTS WITH
!     " INCLUDE 'GRAPHIC.INC' " STATEMENTS      
!
*
*     THIS IS THE GRAPHIC.INC INCLUDE FILE
*


        INTEGER CODE1, CODE2, CODE3, CODE4, CODE5

        INTEGER BLACK, BLUE, GREEN, CYAN, RED, MAGENTA, BROWN
        INTEGER WHITE, DRK_GRAY, LGT_BLUE, LGT_GREEN, LGT_CYAN
        INTEGER LGT_RED, LGT_MAGENTA, YELLOW, BRT_WHITE

        INTEGER GPC_AXESON, GPC_AXESOFF, GPC_XAXIS
        INTEGER GPC_YAXIS,  GPC_XLAB, GPC_YLAB, GPC_AUTOSCAL

        PARAMETER( CODE1=201, CODE2=203, CODE3=205)
        PARAMETER( CODE4=207, CODE5=209 )

        PARAMETER(BLACK=0, BLUE=1, GREEN=2, CYAN=3, RED=4)
        PARAMETER(MAGENTA=5)
        PARAMETER(BROWN=6, WHITE=7, DRK_GRAY=8, LGT_BLUE=9)
        PARAMETER(LGT_GREEN=10, LGT_CYAN=11, LGT_RED=12)
        PARAMETER(LGT_MAGENTA=13, YELLOW=14, BRT_WHITE=15) 
	       
        PARAMETER(GPC_AXESON=0, GPC_AXESOFF=1, GPC_XAXIS=2) 
        PARAMETER(GPC_YAXIS=4, GPC_XLAB=8, GPC_YLAB=16)
        PARAMETER(GPC_AUTOSCAL=32)

        INTEGER GPC_DRAW_MESH, GPC_FILL_ON_CONTOURS, GPC_COLOR_ON_X
        INTEGER GPC_COLOR_ON_Y, USER_UNITS, INCH_UNITS
        INTEGER PIXEL_UNITS
		INTEGER GPC_FILL_CONTOURS_NO_BORDERS, GPC_FILL_CONTOURS_WITH_BORDERS
        INTEGER GPC_CONTOUR_LINE_ATTRIBUTES
        PARAMETER(GPC_DRAW_MESH=1, GPC_FILL_ON_CONTOURS=2)
        PARAMETER(GPC_COLOR_ON_X=4, GPC_COLOR_ON_Y=8)
        PARAMETER( USER_UNITS=1,INCH_UNITS=2,PIXEL_UNITS=4 )
        PARAMETER(GPC_FILL_CONTOURS_NO_BORDERS = 0)
        PARAMETER(GPC_FILL_CONTOURS_WITH_BORDERS = 1)
        PARAMETER(GPC_CONTOUR_LINE_ATTRIBUTES = 2)

      INTEGER, PARAMETER :: CODE1=201, CODE2=203, CODE3=205,
     *    CODE4=207, CODE5=209
 
      INTEGER, PARAMETER :: BLACK=0, BLUE=1, GREEN=2, CYAN=3, RED=4,
     *    MAGENTA=5, BROWN=6, WHITE=7, DRK_GRAY=8, LGT_BLUE=9,
     *    LGT_GREEN=10, LGT_CYAN=11, LGT_RED=12,
     *    LGT_MAGENTA=13, YELLOW=14, BRT_WHITE=15

      INTEGER, PARAMETER :: GPC_AXESON=0, GPC_AXESOFF=1, GPC_XAXIS=2,
     *    GPC_YAXIS=4, GPC_XLAB=8, GPC_YLAB=16,GPC_AUTOSCAL=32

      INTEGER, PARAMETER :: DRAW_MESH=1, FILL_ON_CONTOURS=2,
     *    COLOR_ON_X=4,COLOR_ON_Y=8,
     *    USER_UNITS=1,INCH_UNITS=2,PIXEL_UNITS=4

	INTERFACE 
	    INTEGER FUNCTION ci_sc1q()
	    END FUNCTION CI_SC1Q

	    INTEGER FUNCTION ci_scq()
 	    END FUNCTION CI_SCQ

	    INTEGER FUNCTION ciq()
	    END FUNCTION CIQ

	    INTEGER FUNCTION cstsq()
	    END FUNCTION CSTSQ

     	    INTEGER FUNCTION ENDPLOT()
	    END FUNCTION ENDPLOT
	
	    INTEGER FUNCTION GPCWINprintstr(string1)
    	    CHARACTER string1*(*)
	    END FUNCTION GPCWINprintstr

          INTEGER FUNCTION INTERPOLATEZ(f1, f2, f3, i1, f4,
     *         f5, i2, f6, f7, i3, f8)

	    INTEGER i1, i2, I3
	    REAL f1(*), f2(*), f3(*), F4, F5, F6, F7, F8(I2,*)
	    END FUNCTION INTERPOLATEZ

     	    INTEGER FUNCTION INTOPIX(I1)
	    INTEGER I1
	    END FUNCTION INTOPIX

     	    INTEGER FUNCTION PIXTOINCH(I1)
	    INTEGER I1
	    END FUNCTION PIXTOINCH
	END INTERFACE


      INTERFACE 
          SUBROUTINE FONT(I,S1,C1,S2,C2,S3,C3,S4,C4,S5,C5)
          INTEGER :: I,C1
          CHARACTER(LEN=*) S1
          INTEGER, OPTIONAL :: C2, C3, C4, C5
          CHARACTER(LEN=*), OPTIONAL :: S2, S3, S4, S5
          END SUBROUTINE FONT
      END INTERFACE	


      INTERFACE 
 	    SUBROUTINE CONTCOLOR(I1,I2,I3)
 	    INTEGER :: I1(*), I2
 	    INTEGER, OPTIONAL :: I3(*)
 	    END SUBROUTINE CONTCOLOR
      END INTERFACE

